APP_HTTP_PORT=8080
APP_CORS_ORIGIN=https://your-domain.example
APP_PUBLIC_BASE_URL=https://your-domain.example
APP_BOOTSTRAP_USERS="user1=replace_with_long_password;user2=replace_with_long_password"
APP_SESSION_DAYS=14

POSTGRES_DB=travel_node
POSTGRES_USER=travel_node
POSTGRES_PASSWORD=change_me_to_a_long_random_password

# GitHub Actions CD injects this from the production environment's GOOGLE_MAPS_API_KEY secret.
# Fill it here only when running deploy/deploy.sh manually without Actions.
GOOGLE_MAPS_API_KEY=
GOOGLE_API_MONTHLY_LIMITS=maps-js=10000,routes=10000,places-new=5000,places-photo=1000

# Keep this empty in production so the browser calls the same host's /api,
# which Nginx proxies to the backend container.
VITE_API_BASE_URL=
